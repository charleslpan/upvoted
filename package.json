{
  "name": "upvoted",
  "private": true,
  "description": "A daily podcast of the three biggest Hacker News stories.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:agent": "eve dev",
    "build": "turbo run build",
    "build:agent": "eve build",
    "lint": "turbo run lint lint:root",
    "typecheck": "turbo run typecheck typecheck:root",
    "test": "turbo run test",
    "format": "biome check --write .",
    "episode": "node --import tsx scripts/episode.ts",
    "lint:root": "biome check agent scripts *.json *.md vercel.ts vitest.config.ts",
    "typecheck:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "catalog:",
    "@upvoted/features": "workspace:*",
    "@upvoted/lib": "workspace:*",
    "@upvoted/tsconfig": "workspace:*",
    "@upvoted/types": "workspace:*",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "eve": "1.0.0-rc.2",
    "just-bash": "^3.6.0"
  }
}
