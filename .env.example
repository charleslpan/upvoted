# Copy to .env.local for local runs, or run `vercel env pull` to fetch the project's values.
# Never commit real values.

# Vercel AI Gateway key, for local runs only. Deployments authenticate with Vercel's OIDC token,
# and `vercel env pull` writes a VERCEL_OIDC_TOKEN that works locally too.
AI_GATEWAY_API_KEY=

# Vercel Blob read-write token. When unset, @upvoted/lib/storage writes to out/ at the repo root.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the manual trigger, POST /api/episode.
CRON_SECRET=

# Optional: set to 1 to voice scripts with tones instead of Gemini, for a sample mix without a key.
UPVOTED_FAKE_VOICES=
